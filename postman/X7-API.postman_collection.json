              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@x7.com\",\n  \"password\": \"Cliente123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
